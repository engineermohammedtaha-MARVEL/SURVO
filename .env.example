# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/survo?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Uploads
UPLOAD_DIR="uploads"

# Admin
ADMIN_SECRET="change-this-to-a-long-random-secret"

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Frontend base URL (لبناء روابط زي رابط إعادة تعيين كلمة المرور)
FRONTEND_URL="https://example.github.io/SURVO-FRONTEND"

# Email (Resend - https://resend.com/api-keys)
RESEND_API_KEY=""
RESEND_FROM="SURVO <onboarding@resend.dev>"
